# Ejemplo de configuración para ejecutar WebAR en un entorno controlado.
# En desarrollo puede copiarse a .env; en Vercel los secretos se definen en su panel.
# Nunca se deben incluir credenciales reales en el repositorio.


# La clave privada de Gemini se configura solo en el servidor. No debe publicarse ni exponerse mediante variables VITE_.
GEMINI_API_KEY=


# Lista separada por comas de orígenes completos autorizados a solicitar tokens. Esta medida no reemplaza los límites de cuota.
ALLOWED_ORIGINS=


# Permite cambiar el modelo Live que usa el backend sin modificar su código.
GEMINI_LIVE_MODEL=


# La URL y el token de Upstash activan cuotas compartidas entre instancias; las publicaciones requieren este servicio.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Separa contadores de cuota entre despliegues que utilizan la misma base de Redis.
TOKEN_QUOTA_NAMESPACE=webar


# El modo de pruebas se limita al servidor de desarrollo y nunca debe incluirse en un bundle público.
VITE_FIELD_TEST=0


# Coordenadas de la ubicación real elegida para pruebas de proximidad. No son datos de producción.
VITE_FIELD_TEST_LAT=
VITE_FIELD_TEST_LNG=


# Tipo de contenido temporal con el que se ensaya la invocación de la primera pieza.
VITE_FIELD_TEST_CONTENT=model3d


# Parámetros de radios y precisión usados para ensayos controlados de campo.
VITE_FIELD_TEST_ENTER_RADIUS_M=24
VITE_FIELD_TEST_INVOKE_RADIUS_M=8
VITE_FIELD_TEST_EXIT_RADIUS_M=65
VITE_FIELD_TEST_MAX_PROXIMITY_ACCURACY_M=60
VITE_FIELD_TEST_MAX_INVOKE_ACCURACY_M=30
VITE_FIELD_TEST_VIEW_FILL=0.35
